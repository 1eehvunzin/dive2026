{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec ts-node src/index.ts",
    "build": "tsc && cp src/db/schema.sql dist/db/schema.sql",
    "start": "node dist/index.js",
    "test": "ts-node src/tests/run.ts",
    "validate:data": "ts-node src/scripts/validate-data.ts"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.2",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^1.4.12",
    "@types/node": "^24",
    "nodemon": "^3.1.10",
    "ts-node": "^10.9.2",
    "typescript": "5.7.3"
  }
}
